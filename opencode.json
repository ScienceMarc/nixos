{
	"$schema": "https://opencode.ai/config.json",
	"provider": {
		"llama.cpp": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "Local llama.cpp",
			"options": {
				"baseURL": "http://127.0.0.1:3000/v1"
			},
			"models": {
				"unsloth/Qwen3.5-9B-GGUF:Q6_K": {
					"name": "Local Qwen",
					"limit": {
						"context": 32768,
						"output": 8192
					}
				}
			}
		}
	},
	"permission": {
		"read": {
			"*": "allow",
			"*.env": "ask",
			"*.env.*": "ask"
		},
		"edit": "ask",
		"external_directory": "ask",
		"bash": {
			"*": "ask",
			"git status*": "allow",
			"git diff*": "allow",
			"git branch*": "allow",
			"git commit*": "deny",
			"git push*": "deny",
			"sudo *": "deny",
			"nixos-rebuild switch*": "deny",
			"home-manager switch*": "deny"
		},
		"task": "deny"
	}
}